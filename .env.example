#Nombre de la aplicación docker (Necesario cambiar)
DOCKER_NAME=sistema-quasar
# Define la zona horaria de docker
DOCKER_TIMEZONE=America/Mexico_City
#GROUP_ID que se usara en el contenedor de docker (id -g)
DOCKER_GID=1001
#USER_ID que se usara en el contenedor de docker (id -u)
DOCKER_UID=1001

#Puerto del host donde se ejecuta la aplicación
APP_HOST_PORT=9001

API_URL="http://127.0.0.1:8001/api" #DEV

ENCRYPT_CHANNEL=false
VUE_ROUTER_MODE=history
ENCRYPT_KEY=CHANGE_ME
APP_VERSION=1.0.0.0
#WINDOWS
#PUBLIC_PATH=
#LINUX
PUBLIC_PATH=sistema